  "cards": [
    {
      "dot": "cyan",
      "title": "What Phase 1 does",
      "items": [
        "Reads a video and keeps every frame's real PTS and DTS",
        "Writes the picture as an H.264 stream, copied or re-encoded",
        "Chooses frames for later AI analysis (scene change, N, seconds)",
        "Stores it all in one .virex file and rebuilds a playable mp4"
      ]
    },
    {
      "dot": "emerald",
      "title": ".virex v0.1 sections",
      "items": [
        "Header 72 B and section table, CRC32 on every section",
        "PIXEL: H.264 Annex B with an access unit delimiter per frame",
        "TEMPORAL_INDEX: 32 B per frame (pts, dts, offset, key)",
        "SEMANTIC: SVIR Protobuf, one section or one per layer",
        "METADATA: settings and sampled frames as JSON"
      ]
    },
    {
      "dot": "slate",
      "title": "Where the code lives",
      "items": [
        "cmd/virex-encode, cmd/virex-decode: the two commands",
        "codec/pipeline: runs one encode; codec/encoder: ffprobe + frame pipe",
        "codec/pixel: x264 or copy, Annex B, frame index",
        "codec/scheduler, codec/sampler: bounded frame flow, frame choice",
        "svir/schema: Protobuf schema, validation, layers",
        "codec/container, codec/decoder: file format, MP4 muxer",
        "cost: per-stage JSON-lines log"
      ]
    },
    {
      "dot": "violet",
      "title": "Plugs into the next phases",
      "items": [
        "Phase 2: the sampler's sink hands frames and PTS to the ML client; blocks come back as SVIR",
        "Phase 3: indexes and compact encoding read the same sections; the API reads the file",
        "Phase 4: workers call pipeline.Encode; the cost log feeds evaluation",
        "Dashed edges and the boxes marked Planned are not built yet"
      ]
    },
    {
      "dot": "amber",
      "title": "Checked by tests",
      "items": [
        "Decoded pts, dts and key flags equal the source for every frame",
        "Copy mode: decoded pixels equal the source; re-encode: SSIM about 0.999 on the real clip",
        "Memory stays bounded when the consumer is slow",
        "Damaged sections are rejected by CRC32"
      ]
    }
  ]
}